POSTGRES_USER=prereview
POSTGRES_PASSWORD=prereview
POSTGRES_DB=prereview

DATABASE_URL=postgresql+psycopg2://prereview:prereview@postgres:5432/prereview
# 设置 REDIS_PASSWORD 后 Redis 容器启用口令，REDIS_URL 同步改成 redis://:口令@redis:6379/0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 通义千问 / 硅基流动 / 自定义 / 本地模型请在控制台「系统模块 · 模型配置」填写秘钥与 Base URL
# 本地 Ollama 在 Docker 内请用 http://host.docker.internal:11434/v1，并打开下面的内网开关
LLM_ALLOW_PRIVATE_BASE_URL=false

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
ARK_CHAT_MODEL=doubao-seed-1-8-251228

UPLOAD_DIR=/app/uploads
SAMPLE_DIR=/app/sample_data

# MinIO 容器账号（MINIO_ROOT_*）与后端连接账号（MINIO_ACCESS_KEY / MINIO_SECRET_KEY）必须一致
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=zhibiaoyun
MINIO_SECURE=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

WRITER_BROWSER_URL=http://writer-browser:8010
WRITER_BROWSER_TIMEOUT_SEC=25
WRITER_BROWSER_HOSTS=gov.cn,ccgp.gov.cn,ggzy.gov.cn,chinabidding.com,bidcenter.com.cn,duckduckgo.com,bing.com
# worker 与 writer-browser 之间的共享口令，两边读同一个 .env
WRITER_BROWSER_TOKEN=

# 可选：MinerU HTTP 服务（docker compose --profile mineru up -d）
MINERU_URL=
MINERU_TIMEOUT_SEC=180
MINERU_BACKEND=pipeline

# dev / prod。prod 下 SECRET_KEY 仍为默认值会拒绝启动，并关闭 /docs
APP_ENV=dev
# 是否允许自助注册；注册用户一律为「成员」，不会因为是第一个用户就成为管理员
ALLOW_REGISTER=false
# 首次初始化管理员账号的密码；留空则随机生成并打印在后端日志里
ADMIN_INITIAL_PASSWORD=
# 连续登录失败次数上限与锁定时长（分钟）
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# 上线前必须替换：SECRET_KEY 用 `python -c "import secrets;print(secrets.token_urlsafe(48))"` 生成，
# MinIO 账号密码同样不要沿用 minioadmin（启动日志会对默认值给出提醒）
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 单次上传请求体上限（MB）
MAX_UPLOAD_MB=500

# ======================= SaaS 多企业 =======================
# 每家企业一个 Postgres schema（t_<企业ID>）和一个 MinIO bucket（{前缀}-{企业ID}）；
# 原单企业数据自动迁入「默认企业」，继续使用上面的 MINIO_BUCKET
MINIO_BUCKET_PREFIX=zby
# 登录页「企业注册」入口；注册即开通企业并发放试用积分
ALLOW_TENANT_SIGNUP=true
TRIAL_CREDITS=2000
TRIAL_DAYS=14
# 注册验证码通道：mock（验证码打印在后端日志，仅联调）| off（不校验，仅内网测试）| 正式通道接入后改名
VERIFY_CODE_CHANNEL=mock

# 平台管理后台（https://你的域名/admin/，与企业工作台分开登录）。密码留空则首次启动随机生成并打印在后端日志里，登录后请立即修改并开启二次验证
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_PASSWORD=
PLATFORM_TOKEN_EXPIRE_MINUTES=480
# 逗号分隔的 IP 或网段，例如 10.0.0.0/8,1.2.3.4；留空不限制
PLATFORM_ADMIN_IP_ALLOWLIST=

# ======================= 支付 =======================
# 公网访问地址，支付宝/微信异步通知回调到 {PUBLIC_BASE_URL}/api/pay/notify/{alipay|wechat}
PUBLIC_BASE_URL=http://localhost:3000
PAY_ORDER_EXPIRE_MINUTES=30
# 1 元 = 多少积分
CREDITS_PER_YUAN=10

# 支付宝开放平台（电脑网站支付）。沙箱网关如下，正式环境改为 https://openapi.alipay.com/gateway.do
# 私钥为应用私钥（PKCS#8 或 PKCS#1 均可，可不带 PEM 头），公钥为「支付宝公钥」而非应用公钥
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# 微信支付 APIv3 Native（生成二维码，微信和企业微信均可扫码）
WECHAT_MCHID=
WECHAT_APPID=
# 商户 API 证书序列号与私钥（apiclient_key.pem 内容）
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_API_V3_KEY=
# 微信支付公钥（或平台证书公钥）与其序列号，用于回调验签
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_SERIAL=

# 对公转账收款账户，展示在企业的充值页面；财务在后台核对到账后认领入账
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NO=
BANK_NAME=
